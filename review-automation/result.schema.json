{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "repository": {
      "type": "string"
    },
    "number": {
      "type": "integer"
    },
    "head": {
      "type": "string"
    },
    "base": {
      "type": "string"
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "no_concerns_found",
        "needs_review",
        "changes_required"
      ]
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "fulfilled",
              "not_fulfilled",
              "unverified",
              "not_applicable"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "remaining": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "evidence",
          "remaining"
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "suggestion"
            ]
          },
          "title": {
            "type": "string"
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "trigger": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "actual": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "verification": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "severity",
          "title",
          "file",
          "line",
          "trigger",
          "expected",
          "actual",
          "impact",
          "fix",
          "verification"
        ]
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "previous_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "unavailable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "complete",
        "unavailable"
      ]
    }
  },
  "required": [
    "repository",
    "number",
    "head",
    "base",
    "risk",
    "recommendation",
    "criteria",
    "findings",
    "questions",
    "previous_findings",
    "coverage"
  ]
}
